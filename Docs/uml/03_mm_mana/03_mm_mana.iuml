@startuml 内存管理核心结构设计类图

' =============================================================================
' 一、设计类图 (Design Class Diagram)
' 展示内存管理子系统的核心结构、职责边界和主要依赖关系。
' 重点覆盖 MemorySet / MapArea / PageTable / FrameTracker 以及 mmap 共享组。
' =============================================================================

skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam shadowing false

enum MapType <<enumeration>> {
    Direct
    Framed
}

enum MapAreaType <<enumeration>> {
    Elf
    Stack
    Brk
    Mmap
    Trap
    Shm
    Physical
    MMIO
}

class MapPermission <<bitflags>> {
    R
    W
    X
    U
}

class MmapFlags <<bitflags>> {
    MAP_SHARED
    MAP_PRIVATE
    MAP_FIXED
    MAP_FIXED_NOREPLACE
    MAP_ANONYMOUS
    MAP_STACK
    ...
}

class MemorySet {
    + inner: SyncUnsafeCell<MemorySetInner>
    --
    + new(inner): Self
    + get_mut(): &mut MemorySetInner
    + get_ref(): &MemorySetInner
    + token(): usize
    + mmap(addr, len, perm, flags, file, off): usize
    + munmap(addr, len): SyscallRet
    + mprotect(start_vpn, end_vpn, perm): void
    + lazy_page_fault(vpn, scause): bool
    + cow_page_fault(vpn, scause): bool
    + activate(): void
    + translate(vpn): Option<PhysPageNum>
    + translate_va(va): Option<PhysAddr>
}

class MemorySetInner {
    + page_table: PageTable
    + areas: Vec<MapArea>
    + total_mmap_size: usize
    --
    {static} + new_bare(): Self
    {static} + new_from_kernel(): Self
    {static} + from_elf(elf_data): (Self, usize, ...)
    {static} + from_existed_user(parent): Self
    + token(): usize
    + push(area): void
    + push_lazily(area): void
    + push_with_given_frames(area, frames): void
    + find_insert_addr(hint, size): usize
    + mmap(addr, len, perm, flags, file, off): usize
    + munmap(addr, len): SyscallRet
    + mprotect(start_vpn, end_vpn, perm, file, off, if_mmap): void
    + shm(addr, size, perm, pages): usize
    + lazy_page_fault(vpn, scause): bool
    + cow_page_fault(vpn, scause): bool
    + recycle_data_pages(): SyscallRet
    + resident_size_kb(): usize
    + virtual_size_kb(): usize
}

class MapArea {
    + vpn_range: VPNRange
    + data_frames: BTreeMap<VirtPageNum, Arc<FrameTracker>>
    + map_type: MapType
    + map_perm: MapPermission
    + area_type: MapAreaType
    + mmap_file: MmapFile
    + mmap_flags: MmapFlags
    + groupid: usize
    --
    {static} + new(start, end, type, perm, area_type): Self
    {static} + new_mmap(start, end, type, perm, area_type, file, off, flags): Self
    {static} + from_another(area): Self
    + map_one(page_table, vpn): Option<PhysPageNum>
    + unmap_one(page_table, vpn): void
    + map(page_table): Result
    + map_given_frames(page_table, frames): void
    + unmap(page_table): void
    + copy_data(page_table, data, offset): void
    + kernel_stack_frame(): Vec<Arc<FrameTracker>>
}

class MmapFile <<value object>> {
    + file: Option<Arc<OSFile>>
    + offset: usize
    --
    {static} + empty(): Self
    {static} + new(file, offset): Self
}

class VPNRange <<iterator>> {
    - start: VirtPageNum
    - end: VirtPageNum
    --
    {static} + new(start, end): Self
    + start(): VirtPageNum
    + end(): VirtPageNum
    + range(): (VirtPageNum, VirtPageNum)
}

class PageTable {
    - root_ppn: PhysPageNum
    - frames: Vec<Arc<FrameTracker>>
    --
    {static} + new(): Self
    {static} + new_from_kernel(): Self
    + token(): usize
    + map(vpn, ppn, perm): void
    + unmap(vpn): void
    + translate(vpn): Option<PhysPageNum>
    + translate_va(va): Option<PhysAddr>
    + find_pte_create(vpn): Option<&mut PTE>
    + find_pte(vpn): Option<&mut PTE>
    + handle_mprotect(vpn, flags): void
    + handle_cow_page_fault(va, vma): bool
    + handle_mmap_read_page_fault(vpn, ppn, perm, flags): void
    + handle_mmap_write_page_fault(vpn, perm, flags): void
}

class PageTableEntry <<arch specific>> {
    + bits: usize
    --
    + ppn(): PhysPageNum
    + flags(): PTEFlags
    + is_valid(): bool
    + readable(): bool
    + writable(): bool
    + executable(): bool
}

class FrameTracker <<RAII>> {
    + ppn: PhysPageNum
    --
    {static} + alloc(): Option<Arc<Self>>
    <<Drop>> dealloc frame to CMA
}

class CMAAllocator <<singleton>> {
    {static} - CMA_ALLOCATOR: LockedHeap
    --
    {static} + init_cma(): void
    {static} + alloc_pages(order): Option<PhysAddr>
    {static} + dealloc_pages(pa, order): void
}

class GroupManager <<singleton>> {
    - unused_id: Vec<usize>
    - groups: BTreeMap<usize, GroupInner>
    --
    {static} - GROUP_SHARE: Mutex<GroupManager>
    + alloc_id(): usize
    + add_area(id): void
    + del_area(id): void
    + add_frame(id, vpn, frame): void
    + find(id, vpn): Option<Arc<FrameTracker>>
}

class GroupInner {
    + shared_frames: BTreeMap<VirtPageNum, Arc<FrameTracker>>
    + maparea_num: usize
}

class ProcessInner <<external>> {
    + memory_set: Arc<RwLock<MemorySet>>
    --
    + get_locked_memory_set_write(): RwLockWriteGuard<MemorySet>
    + get_locked_memory_set_read(): RwLockReadGuard<MemorySet>
}

class SyscallMM <<module>> {
    {static} + sys_mmap(addr, len, prot, flags, fd, off): SyscallRet
    {static} + sys_munmap(addr, len): SyscallRet
    {static} + sys_mprotect(addr, len, prot): SyscallRet
    {static} + sys_mremap(old_addr, old_size, new_size, flags, new_addr): SyscallRet
    {static} + sys_mincore(addr, length, vec): SyscallRet
}

class PageFaultHandler <<module>> {
    {static} + mmap_write_page_fault(va, page_table, vma): bool
    {static} + mmap_read_page_fault(va, page_table, vma): bool
    {static} + lazy_page_fault(va, page_table, vma): bool
    {static} + cow_page_fault(va, page_table, vma): bool
}

MemorySet *-- MemorySetInner : owns through\nSyncUnsafeCell
MemorySetInner *-- PageTable
MemorySetInner *-- "0..*" MapArea
MapArea *-- VPNRange
MapArea *-- MmapFile
MapArea --> MapType
MapArea --> MapAreaType
MapArea --> MapPermission
MapArea --> MmapFlags
MapArea o-- "0..*" FrameTracker : data_frames
PageTable o-- "1..*" FrameTracker : page-table frames
PageTable --> PageTableEntry
FrameTracker --> CMAAllocator : alloc/free
MapArea ..> PageTable : map/unmap
MapArea ..> GroupManager : MAP_SHARED groupid
GroupManager *-- "0..*" GroupInner
GroupInner o-- "0..*" FrameTracker : shared_frames
ProcessInner o-- MemorySet
SyscallMM ..> ProcessInner : current_task()\nprocess lock
SyscallMM ..> MemorySet : wrapper methods
MemorySetInner ..> PageFaultHandler : delegates fault handling
PageFaultHandler ..> GroupManager : share lookup/register
PageFaultHandler ..> PageTable : PTE update

note right of MemorySet
  外层 ProcessInner 持有 RwLock<MemorySet>。
  MemorySet 内部使用 SyncUnsafeCell，
  因此 get_mut/get_ref 依赖调用者已经持锁。
end note

note bottom of MapArea
  MapArea 是 VMA 级逻辑段。
  vpn_range 描述虚拟区间，
  data_frames 负责物理帧生命周期和 COW 引用计数，
  页表只保存硬件可见的 VPN -> PPN 映射。
end note

note bottom of GroupManager
  GROUP_SHARE 只服务 MAP_SHARED mmap。
  groupid 以 MapArea 为粒度，
  lazy fault 首次分配后注册共享帧，
  后续进程 Clone Arc<FrameTracker> 复用同一页。
end note

@enduml

@startuml mmap系统顺序图

' =============================================================================
' 二、系统顺序图 (System Sequence Diagram)
' 展示用户 mmap 调用从 syscall 入口到 MemorySet 建立懒分配 VMA 的主路径。
' =============================================================================

skinparam sequenceMessageAlign center
skinparam shadowing false

actor User as U
participant "sys_mmap" as SYS
participant "current_task/process" as PROC
participant "FdTable/OSFile" as FD
participant "MemorySet" as MS
participant "MemorySetInner" as MSI
participant "MapArea" as AREA
participant "GROUP_SHARE" as GS
participant "BAD_ADDRESS" as BAD

U -> SYS : mmap(addr, len, prot, flags, fd, off)
activate SYS
SYS -> SYS : page_round_up(len)\nprot -> MapPermission\nflags -> MmapFlags
SYS -> PROC : current_task().process.inner_lock()
PROC --> SYS : ProcessInner
SYS -> PROC : get_locked_memory_set_write()
PROC --> SYS : RwLockWriteGuard<MemorySet>

alt fd == -1 and MAP_ANONYMOUS
    SYS -> MS : mmap(addr, len, perm, flags, None, off)
else fd == -1 and not MAP_ANONYMOUS
    SYS --> U : -EBADF
else fd valid and MAP_ANONYMOUS
    SYS -> MS : mmap(0, 1, empty_perm, flags, None, usize::MAX)
    MS -> MSI : mmap(...)
    MSI -> MSI : find_insert_addr(MMAP_TOP, 1)
    MSI -> AREA : new_mmap(..., empty_perm, MAP_PRIVATE)
    MSI -> MSI : push_lazily(area)
    MSI --> MS : bad_addr
    MS --> SYS : bad_addr
    SYS -> BAD : insert_bad_address(bad_addr)
    SYS --> U : bad_addr
else fd valid and file-backed
    SYS -> FD : fd_table.get(fd)?.file()?
    FD --> SYS : Arc<OSFile>
    SYS -> SYS : check readable/writable\nagainst perm and MAP_SHARED
    alt permission mismatch
        SYS --> U : -EACCES
    else permission ok
        SYS -> MS : mmap(addr, len, perm, flags, Some(file), off)
    end
end

MS -> MSI : mmap(addr, len, perm, flags, file, off)
activate MSI
alt MAP_FIXED or MAP_FIXED_NOREPLACE
    MSI -> MSI : checked_add(addr, len)\ncalculate [start_vpn, end_vpn)
    alt MAP_FIXED_NOREPLACE overlaps
        MSI --> MS : 0
    else existing area fully covers range and needs split
        MSI -> MSI : mprotect(start_vpn, end_vpn,\nperm, file, off, if_mmap=true)
        MSI --> MS : addr
    else no split needed
        MSI -> AREA : new_mmap(addr, addr+len,\nFramed, perm, Mmap, file, off, flags)
        alt MAP_SHARED
            AREA -> GS : alloc_id(); add_area(groupid)
        end
        MSI -> MSI : push_lazily(area)
        MSI --> MS : addr
    end
else normal mmap
    MSI -> MSI : check total_mmap_size + len <= MAX_MMAP_SIZE
    alt over limit
        MSI --> MS : 0
    else under limit
        MSI -> MSI : find_insert_addr(MMAP_TOP, len)
        MSI -> AREA : new_mmap(found, found+len,\nFramed, perm, type, file, off, flags)
        alt MAP_SHARED
            AREA -> GS : alloc_id(); add_area(groupid)
        end
        MSI -> MSI : push_lazily(area)\ntotal_mmap_size += len
        MSI --> MS : found
    end
end
deactivate MSI

MS --> SYS : mapped_addr or 0
alt mapped_addr == 0
    SYS --> U : -EEXIST or -ENOMEM
else success
    SYS --> U : mapped_addr
end
deactivate SYS

note over MSI,AREA
  mmap 只注册 MapArea，不立即分配物理页。
  首次访问由 Load/Store PageFault 触发 lazy allocation。
end note

@enduml

@startuml munmap活动图

' =============================================================================
' 三、活动图 (Activity Diagram)
' 展示 munmap 的校验、MAP_SHARED 写回、页表解映射和 VMA 回收路径。
' =============================================================================

skinparam shadowing false

|用户态 / syscall 层|
start
:sys_munmap(addr, len);
if (addr page aligned?) then (yes)
else (no)
    :return -EINVAL;
    stop
endif
:len = page_round_up(len);
:end = checked_add(addr, len);
if (overflow?) then (yes)
    :return -EINVAL;
    stop
else (no)
endif
:lock current process MemorySet for write;
if (addr in BAD_ADDRESS?) then (yes)
    :remove_bad_address(addr);
endif

|MemorySetInner|
:MemorySetInner::munmap(addr, len);
:calculate [start_vpn, end_vpn);

while (exists Mmap area fully covered\nby [start_vpn, end_vpn)?) is (yes)
    :area = next covered MapArea;
    if (MAP_SHARED && writable && file-backed?) then (yes)
        |MapArea / OSFile|
        :file = area.mmap_file.file;
        if (file inode still linked?) then (yes)
            :build contiguous dirty/resident page ranges\nfrom area.data_frames;
            :save current file offset;
            while (range remains?) is (yes)
                :read mapped user pages in 64KB chunks\nwith read_user_bytes_direct_into();
                :seek to file_base + page offset;
                :write chunk back to file;
            endwhile (no)
            :restore file offset;
        else (unlinked)
            :skip writeback;
        endif
    endif

    |MapArea|
    :for each vpn in target range\narea.unmap_one(page_table, vpn);
    |PageTable / TLB|
    :page_table.unmap(vpn);

    |MemorySetInner|
    if (whole area removed?) then (yes)
        :total_mmap_size -= area_size;
        :remove area from areas;
    else (partial front trimmed)
        :total_mmap_size -= trimmed_size;
        :area.vpn_range = [end_vpn, area_end_vpn);
    endif

    |PageTable / TLB|
    :tlb_invalidate();
    |MemorySetInner|
endwhile (no)

|用户态 / syscall 层|
:return 0;
stop

@enduml

@startuml mprotect活动图

' =============================================================================
' 四、活动图 (Activity Diagram)
' 展示 mprotect 对 MapArea 的四类拆分和页表权限更新。
' =============================================================================

skinparam shadowing false

|用户态 / syscall 层|
start
:sys_mprotect(addr, len, prot);
if (addr and len page aligned?) then (yes)
else (no)
    :return -EINVAL;
    stop
endif
:end_addr = checked_add(addr, len);
if (overflow?) then (yes)
    :return -EINVAL;
    stop
else (no)
endif
:prot -> MapPermission;
:lock current process MemorySet for write;
:start_vpn = floor(addr)\nend_vpn = ceil(end_addr);

|MemorySetInner|
:MemorySetInner::mprotect(start_vpn, end_vpn, perm);

if (start_vpn >= end_vpn?) then (yes)
    |用户态 / syscall 层|
    :return 0;
    stop
else (no)
endif

:new_areas = [];
while (iterate each area in areas) is (next)
    |MapArea|
    :read area range [start, end);
    if (area fully inside target?) then (case 1)
        :area.map_perm = new perm;
        if (called from mmap MAP_FIXED split?) then (yes)
            :update mmap_file / offset;
        endif
    elseif (left side outside,\nright side inside target?) then (case 2)
        :new_area = clone metadata from area;
        :new_area range = [start_vpn, end);
        :new_area.map_perm = new perm;
        :area range = [start, start_vpn);
        :GROUP_SHARE.add_area(new_area.groupid);
        :move data_frames with vpn >= start_vpn\nto new_area;
        |MemorySetInner|
        :new_areas.push(new_area);
    elseif (left side inside target,\nright side outside?) then (case 3)
        |MapArea|
        :new_area = clone metadata from area;
        :new_area range = [start, end_vpn);
        :new_area.map_perm = new perm;
        :area range = [end_vpn, end);
        :GROUP_SHARE.add_area(new_area.groupid);
        :move data_frames with vpn < end_vpn\nto new_area;
        |MemorySetInner|
        :new_areas.push(new_area);
    elseif (area surrounds target?) then (case 4)
        |MapArea|
        :front_area = clone metadata from area;
        :back_area = clone metadata from area;
        :front range = [start, start_vpn);
        :middle area range = [start_vpn, end_vpn);
        :back range = [end_vpn, end);
        :middle area.map_perm = new perm;
        :GROUP_SHARE.add_area(front.groupid);
        :GROUP_SHARE.add_area(back.groupid);
        :move frames before target to front_area;
        :move frames after target to back_area;
        |MemorySetInner|
        :new_areas.push(front_area, back_area);
    else (no overlap)
        |MapArea|
        :leave area unchanged;
    endif
    |MemorySetInner|
endwhile (done)

:append new_areas to areas;
|PageTable / TLB|
:for vpn in [start_vpn, end_vpn)\npage_table.handle_mprotect(vpn, perm);
:tlb_invalidate();

|用户态 / syscall 层|
:return 0;
stop

note right
  逻辑段拆分负责维护 VMA 语义，
  handle_mprotect 负责更新已存在页的硬件 PTE 权限。
end note

@enduml

@startuml 缺页处理交互图

' =============================================================================
' 五、交互图 (Communication / Sequence Diagram)
' 展示 mmap/brk/stack 的懒分配、MAP_SHARED 共享页复用和 COW 写时复制。
' =============================================================================

skinparam sequenceMessageAlign center
skinparam shadowing false

participant "trap_handler" as TRAP
participant "MemorySet" as MS
participant "MemorySetInner" as MSI
participant "PageTable" as PT
participant "MapArea" as AREA
participant "PageFaultHandler" as PFH
participant "GROUP_SHARE" as GS
participant "OSFile" as FILE
participant "FrameTracker/CMA" as FRAME

TRAP -> MS : lazy_page_fault(vpn, scause)
MS -> MSI : lazy_page_fault(vpn, scause)
MSI -> PT : translate(vpn)
alt PTE already mapped
    MSI --> MS : false
    MS --> TRAP : try COW path
else no mapping
    MSI -> MSI : find area containing vpn
    alt area_type == Mmap
        alt LoadPageFault or FetchInstructionPageFault
            MSI -> PFH : mmap_read_page_fault(va, page_table, area)
            PFH -> GS : find(area.groupid, vpn)
            alt shared frame exists
                GS --> PFH : Arc<FrameTracker>
                PFH -> AREA : data_frames.insert(vpn, frame)
                PFH -> PT : handle_mmap_read_page_fault(vpn, ppn, perm, flags)
                PFH --> MSI : true
            else no shared frame
                PFH -> PFH : mmap_write_page_fault(va, page_table, area)
                PFH -> AREA : map_one(page_table, vpn)
                AREA -> FRAME : alloc zeroed frame
                AREA -> PT : map(vpn, ppn, perm)
                alt file-backed mmap
                    PFH -> FILE : seek/read one page
                    PFH -> PT : write_user_bytes_direct(token, va, page)
                end
                PFH -> PT : handle_mmap_write_page_fault(vpn, perm, flags)
                alt MAP_SHARED groupid != 0
                    PFH -> GS : add_frame(groupid, vpn, frame)
                end
                PFH --> MSI : true or false on OOM
            end
        else StorePageFault
            MSI -> PFH : mmap_write_page_fault(va, page_table, area)
            PFH -> AREA : map_one(page_table, vpn)
            AREA -> FRAME : alloc zeroed frame
            AREA -> PT : map(vpn, ppn, perm)
            alt file-backed mmap
                PFH -> FILE : seek/read one page
                PFH -> PT : write_user_bytes_direct(token, va, page)
            end
            PFH -> PT : handle_mmap_write_page_fault(vpn, perm, flags)
            PFH --> MSI : true or false on OOM
        end
    else area_type == Brk or Stack
        MSI -> PFH : lazy_page_fault(va, page_table, area)
        PFH -> AREA : map_one(page_table, vpn)
        AREA -> FRAME : alloc zeroed frame
        AREA -> PT : map(vpn, ppn, perm)
        PFH --> MSI : true or false on OOM
    else no repairable area
        MSI --> MS : false
    end
end

alt lazy path succeeds
    MS --> TRAP : return to user instruction
else lazy path fails
    TRAP -> MS : cow_page_fault(vpn, scause)
    MS -> MSI : cow_page_fault(vpn, scause)
    alt scause is Load/Fetch
        MSI --> MS : false
    else Store/PageModify fault
        MSI -> MSI : find Elf/Brk/Mmap/Stack area
        alt COW-capable area found
            MSI -> PFH : cow_page_fault(va, page_table, area)
            PFH -> PT : handle_cow_page_fault(va, area)
            PT -> AREA : inspect data_frames and refcount
            alt refcount == 1
                PT -> PT : clear COW, add WRITE/READ/DIRTY
            else refcount >= 2
                PT -> FRAME : alloc new frame
                PT -> AREA : unmap old frame\nmap new frame
                PT -> PT : copy old page bytes\nset writable PTE
            end
            PT --> PFH : true
            PFH --> MSI : true
        else not found
            MSI --> MS : false
        end
    end
end

alt COW succeeds
    MS --> TRAP : return to user instruction
else all handlers fail
    TRAP -> TRAP : send SIGSEGV
end

note over TRAP,MSI
  trap_handler 先尝试 lazy_page_fault，
  再尝试 cow_page_fault。
  两者都失败时才向用户线程发送 SIGSEGV。
end note

@enduml
