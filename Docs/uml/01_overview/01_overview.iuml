@startuml Ya2yOS领域模型-模块依赖关系

' Ya2yOS 领域模型 - 内核模块依赖关系图
' 根据当前 os/src、os/Cargo.toml 与 Makefile 更新
' 分层架构: 基础层 -> 架构抽象层 -> 核心服务层 -> 领域服务层 -> 系统调用层 -> 陷入层

skinparam componentFontSize 12
skinparam componentFontStyle bold
skinparam packageFontSize 13
skinparam packageFontStyle bold
skinparam packageStyle rectangle
skinparam defaultFontSize 11
skinparam arrowThickness 1.5
skinparam linetype ortho

' 外部依赖 (External Crates / 平台)
package "外部依赖 (External Crates)" as ExtCrates #F2F2F2 {
    component "smoltcp\nTCP/IP协议栈" as smoltcp <<external>> #FFF0F0
    component "virtio-drivers\nVirtIO块/网卡驱动" as virtio_drivers <<external>> #FFF0F0
    component "lwext4_rust\next4文件系统" as lwext4 <<external>> #FFF0F0
    component "buddy_system_allocator\n内核堆/CMA分配" as buddy <<external>> #FFF0F0
    component "xmas-elf\nELF解析器" as xmas_elf <<external>> #FFF0F0
    component "spin / kspin / kernel_guard\n锁与临界区" as spin_crate <<external>> #FFF0F0
    component "hashbrown / smallvec\n集合容器" as collections <<external>> #FFF0F0
    component "linux-raw-sys\nLinux ABI类型" as linux_raw <<external>> #FFF0F0
    component "event-listener / futures-util\n异步等待支撑" as async_crates <<external>> #FFF0F0
    component "num_enum / cfg-if / bitflags\n枚举转换与条件编译" as helper_crates <<external>> #FFF0F0
    component "riscv / sbi-rt\nRISC-V CSR/SBI" as riscv_crates <<external>> #FFF0F0
    component "loongArch64\nLoongArch寄存器" as loongarch_crate <<external>> #FFF0F0
}

package "运行平台 (Platform)" as Platform #F2F2F2 {
    component "QEMU virt\nriscv64 / loongarch64" as QEMU <<external>> #FFF0F0
    component "OpenSBI\nRISC-V启动与定时器SBI" as OpenSBI <<external>> #FFF0F0
    component "sdcard-rv.img / sdcard-la.img\n测试根文件系统" as Sdcard <<external>> #FFF0F0
}

' Layer 0: 基础层
package "基础层 (Foundation)" as Layer0 #E8F5E9 {
    component utils #C8E6C9 [
        utils
        通用工具
        ----
        - error: SysErrNo / SysResult / GeneralRet
        - id_allocator: PID/TID/通用ID分配器
        - simple_range: SimpleRange / StepByOne
        - string: 用户字符串辅助
        - poll: PollEvents / poll辅助
        - page_round_up() / backtrace()
    ]

    component sync_module #C8E6C9 [
        sync
        内核同步原语
        ----
        - UPSafeCell
        - SyncUnsafeCell
        - 配合 spin/kspin/kernel_guard 使用
    ]

    component config #C8E6C9 [
        config
        编译期常量
        ----
        - 内核堆/栈大小
        - 页大小与地址范围常量
        - FD/路径/任务限制
        - 条件编译开关
    ]

    component lang_items #C8E6C9 [
        lang_items
        Rust语言项
        ----
        - panic_handler
        - alloc_error_handler
        - eh_personality
    ]

    component logger #C8E6C9 [
        logger
        日志系统
        ----
        - log level feature
        - log crate 后端
        - console 输出
    ]
}

' Layer 1: 架构抽象层
package "架构抽象层 (Architecture Abstraction)" as Layer1 #E3F2FD {
    component arch #BBDEFB [
        arch
        架构抽象模块
        ----
        - target_arch 条件分发
        - cpu: hart_id / 多核入口
        - console: UART输出
        - memory_layout: 内核/用户地址布局
        - page_table / tlb: 页表与TLB操作
        - context: TrapContext / TaskContext
        - trap_interface: 陷入入口与CSR/寄存器操作
        - time: 时钟频率与单次定时器
        - irq: HandlerTable 中断路由
    ]

    together {
        component "arch::riscv64::qemu\nRISC-V64实现" as riscv64 #A9D1F5
        component "arch::loongarch64::qemu\nLoongArch64实现" as loongarch64 #A9D1F5
        component "arch::irq\n中断处理路由" as irq #A9D1F5
    }

    arch --> riscv64 : "cfg(target_arch)"
    arch --> loongarch64 : "cfg(target_arch)"
    arch --> irq

    component console #BBDEFB [
        console
        print!/println! 后端
        ----
        - console_putchar()
        - 架构UART适配
        - logger 与 panic 输出
    ]
}

' Layer 2: 核心服务层
package "核心服务层 (Core Services)" as Layer2 #FFF3E0 {
    component mm #FFE0B2 [
        mm
        内存管理
        ----
        - address: VirtAddr / PhysAddr / VPN / PPN
        - heap_allocator: 内核堆
        - frame_alloc: CMA帧分配 / FrameTracker / page_cache
        - MemorySet / MemorySetInner / KERNEL_SPACE
        - MapArea / mmap_ops / fork_clone / elf_loader
        - translate: copy_to/from_user / UserBuffer
        - page_fault_handler: lazy / COW 缺页
        - shm: SysV共享内存
        - mmap_bad_address 防护
    ]

    component drivers #FFE0B2 [
        drivers
        设备驱动
        ----
        - BaseDriver / BlockDriver / NetDriverOps
        - DeviceContainer(SmallVec)
        - disk: BLOCK_DEVICE
        - virtio::riscv: MMIO块设备
        - virtio::loongarch: PCI块/网卡设备
        - virtio::net: VirtIoNetDev
        - net_buf: NetBufPool
    ]

    component timer #FFE0B2 [
        timer
        时间与定时器
        ----
        - set_next_trigger()
        - Timespec / TimeVal / Tms
        - Rusage / TimeData
        - Itimerval / per-thread Timer
        - Timex: adjtimex/clock_adjtime
        - TimerCondVar / futex超时
    ]
}

' Layer 3: 领域服务层
package "领域服务层 (Domain Services)" as Layer3 #F3E5F5 {
    component task #E1BEE7 [
        task
        任务/进程管理
        ----
        - TaskControlBlock / TaskStatus
        - Process / 线程组 / 进程资源
        - TaskManager / ready_queue
        - Processor / PROCESSORS 每核调度器
        - TaskContext / __switch / __abandon
        - TidHandle / KernelStackOnHeap
        - futex / robust_list / 任务计时器
        - future: 异步poll/time (net feature)
        - clone / execve / exit / wait / schedule
        - Sysinfo / auxv / initproc
    ]

    component fs #E1BEE7 [
        fs
        文件系统与VFS
        ----
        - ext4_lw: superblock / inode / lwext4
        - vfs: File / Inode / FileClass
        - fstruct: FdTable / FsContext
        - mount: MNT_TABLE / mount namespace
        - kernel_fs_ops: open / initfiles / proc_file
        - files: devfs / pipe / events / inotify
        - files: mqueue / signalfd / loopdev / mountfd
        - stat / fs_info / dynamic linker mapping
    ]

    component signal #E1BEE7 [
        signal
        信号机制
        ----
        - SigSet / SigAction / KSigAction
        - SigInfo / SigTable / SigTableInner
        - send_signal_to_thread()
        - send_signal_to_thread_group()
        - handle_signal()
        - sigframe / sigreturn 用户栈帧
        - signalfd 通过 fs::files 暴露
    ]

    component net #E1BEE7 [
        net
        网络协议栈 (feature = net)
        ----
        - init_network(DeviceContainer)
        - LoopbackDevice / EthernetDevice
        - Router / Rule / Service
        - SocketSetWrapper / LISTEN_TABLE
        - TCP / UDP / Unix Domain Socket
        - socket options / cmsg / addr转换
        - poll_interfaces()
        - smoltcp 协议栈集成
    ]
}

' Layer 4: 系统调用层
package "系统调用层 (System Call Layer)" as Layer4 #EDE7F6 {
    component syscall #CE93D8 [
        syscall
        系统调用分发
        ----
        - Syscall enum: Linux/RISC-V syscall号
        - syscall(id, args) 主分发函数
        - 成功返回usize，失败返回SysErrNo
        ----
        子模块:
        - task / mm / fs / net
        - signal / sync / time
        - io_mpx / resource / sys
        - options: ABI类型与常量
    ]

    together {
        component "syscall::task\nclone/exec/exit/wait/调度/身份" as syscall_task #D1C4E9
        component "syscall::mm\nbrk/mmap/mprotect/mlock/shm" as syscall_mm #D1C4E9
        component "syscall::fs\nopen/read/write/mount/stat/xattr/mqueue" as syscall_fs #D1C4E9
        component "syscall::net\nsocket/bind/connect/sendmsg/setsockopt" as syscall_net #D1C4E9
        component "syscall::signal\nsigaction/kill/sigprocmask/sigtimedwait" as syscall_sig #D1C4E9
        component "syscall::sync\nfutex/robust_list" as syscall_sync #D1C4E9
        component "syscall::time\nclock/nanosleep/timerfd/adjtimex" as syscall_time #D1C4E9
        component "syscall::io_mpx\nepoll/poll/select" as syscall_iompx #D1C4E9
        component "syscall::resource / sys / options\nrlimit/rusage/syslog/ABI选项" as syscall_misc #D1C4E9
    }

    syscall --> syscall_task
    syscall --> syscall_mm
    syscall --> syscall_fs
    syscall --> syscall_net
    syscall --> syscall_sig
    syscall --> syscall_sync
    syscall --> syscall_time
    syscall --> syscall_iompx
    syscall --> syscall_misc
}

' Layer 5: 陷入处理层
package "陷入处理层 (Trap Handling Layer)" as Layer5 #FFEBEE {
    component trap #FFCDD2 [
        trap
        陷入处理
        ----
        - trap::init() -> arch::trap_interface::trap_init()
        - __trap_from_user 汇编入口
        - trap_handler() 主分发
        - syscall: sepc_step + a0返回值
        - page fault: lazy / COW / SIGSEGV
        - timer interrupt: 任务计时 + 抢占
        - signal: handle_signal()
        - trap_types: Trap / Exception / Interrupt
    ]
}

' 内核入口
package "内核入口 (Entry Point)" as Entry #E8EAF6 {
    component main_component #C5CAE9 [
        main
        rust_main(hartid)
        ----
        首核初始化:
        - clear_bss()
        - arch::time::init_clock_freq()
        - mm::init()
        - logger::init()
        - trap::init()
        - task::init()
        - fs::init()
        - net::init_network() (net feature)
        - task::add_initproc()
        - enable_timer_interrupt()
        - timer::set_next_trigger()
        ----
        其他核:
        - 等待 INIT_FINISHED
        - trap::init()
        - mm::activate_kernel_space()
        - enable_timer_interrupt()
        - timer::set_next_trigger()
        ----
        最终:
        - fs::list_apps()
        - task::run_tasks()
    ]
}

' 依赖关系
' --- Layer 0 内部依赖 ---
logger --> console : "格式化输出"
logger --> config : "日志等级 feature"
console --> arch : "UART输出"
utils --> mm : "VirtAddr / PAGE_SIZE"

' --- Layer 1 -> Layer 0 / 平台 ---
arch --> config : "平台常量"
arch --> riscv_crates : "RISC-V CSR"
arch --> loongarch_crate : "LoongArch寄存器"
arch --> OpenSBI : "RISC-V set_timer"
arch --> QEMU : "virt平台设备地址"

' --- Layer 2 -> Layer 1/0 ---
mm --> arch : "页表/TLB/地址布局"
mm --> utils : "SimpleRange / UserBuffer"
mm --> buddy : "堆与连续页分配"
mm --> xmas_elf : "ELF装载"
mm --> sync_module : "KERNEL_SPACE锁"

drivers --> arch : "VirtIO MMIO/PCI地址与DMA转换"
drivers --> virtio_drivers : "VirtIO Transport / Blk / Net"
drivers --> collections : "DeviceContainer(SmallVec)"
drivers --> sync_module : "设备锁"

timer --> arch : "get_time / set_oneshot_timer"
timer --> task : "任务时间统计"
timer --> sync_module : "TimerCondVar等待"

' --- Layer 3 -> Layer 2/1/0 ---
task --> arch : "hart_id / context switch"
task --> mm : "地址空间 / copy_to_user / ELF映射"
task --> fs : "open initproc / procfs维护"
task --> signal : "线程组信号 / SigSet"
task --> timer : "任务计时器 / futex超时"
task --> utils : "ID分配 / SysErrNo"
task --> sync_module : "锁与临界区"
task --> async_crates : "future/poll等待"

fs --> mm : "UserBuffer / VirtAddr / mmap映射"
fs --> drivers : "BlockDriver / BLOCK_DEVICE"
fs --> lwext4 : "ext4读写"
fs --> utils : "SysErrNo / GeneralRet / poll"
fs --> sync_module : "文件与inode锁"
fs --> linux_raw : "stat/ioctl/loop等ABI"

signal --> arch : "TrapContext / 用户栈帧"
signal --> mm : "copy_from/to_user / VirtAddr"
signal --> task : "TCB / Process / ready_queue"
signal --> utils : "SysErrNo / SyscallRet"
signal --> sync_module : "SigTable锁"

net --> drivers : "NetDeviceImpl / NetDriverOps"
net --> fs : "Socket作为FileClass"
net --> smoltcp : "TCP/IP协议栈"
net --> utils : "SysErrNo / SysResult"
net --> sync_module : "SocketSet与Service锁"
net --> linux_raw : "sockaddr / socket ABI"

' --- Layer 4 -> Layer 3/2 ---
syscall_task --> task : "clone3/execve/exit/wait4/sched"
syscall_task --> timer : "rusage/times"
syscall_mm --> mm : "brk/mmap/munmap/mprotect/mlock/shm"
syscall_fs --> fs : "openat/read/write/mount/statx/xattr"
syscall_net --> net : "socket/connect/sendmsg/recvmsg/options"
syscall_net --> fs : "socket fd 与 FileClass"
syscall_sig --> signal : "sigaction/kill/sigprocmask"
syscall_sync --> task : "futex/set_robust_list"
syscall_time --> timer : "nanosleep/clock_gettime/timerfd"
syscall_iompx --> fs : "poll/epoll/select文件事件"
syscall_misc --> task : "rlimit/rusage/sysinfo/prctl"
syscall_misc --> utils : "ABI选项与错误码"

syscall --> task : "current_task / current_trap_cx"
syscall --> arch : "shutdown / trap上下文"
syscall --> utils : "SyscallRet / SysErrNo"
syscall --> linux_raw : "Linux ABI结构体"
syscall --> helper_crates : "Syscall enum转换"

' --- Layer 5 -> Layer 4/3/2 ---
trap --> arch : "trap_interface / page_table / hart_id"
trap --> syscall : "syscall() 分发"
trap --> task : "current_task / suspend / exit"
trap --> signal : "SIGSEGV / handle_signal"
trap --> timer : "check_futex_timer / set_next_trigger"
trap --> mm : "VirtAddr / VirtPageNum / 缺页处理"
trap --> utils : "backtrace"

' --- Entry -> All Layers ---
main_component --> arch : "架构初始化 / 多核启动状态"
main_component --> mm : "内存子系统初始化"
main_component --> logger : "日志初始化"
main_component --> trap : "trap_init"
main_component --> task : "任务管理初始化 / initproc / run_tasks"
main_component --> fs : "根文件系统挂载