@startuml 进程管理设计类图

' =============================================================================
' 一、设计类图 (Design Class Diagram)
' 展示进程管理子系统的核心类、属性、方法及其关系
' 体现 GRASP 设计模式: Information Expert, High Cohesion, Low Coupling
' =============================================================================

skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam classFontStyle bold
skinparam packageStyle rectangle

' --- 枚举 ---
enum TaskStatus <<enumeration>> {
    Ready
    Running
    Blocked
    VforkBlocked
    Zombie
    Stopped
}

enum WaitPid <<enumeration>> {
    Any
    Pid(usize)
    Pgid(u32)
    +
    apply(child: &Process): bool
}

class CloneFlags <<bitflags>> {
    CLONE_VM
    CLONE_FILES
    CLONE_SIGHAND
    CLONE_THREAD
    CLONE_VFORK
    CLONE_CHILD_CLEARTID
    CLONE_SETTLS
    CLONE_FS
    CLONE_PARENT
    CLONE_CHILD_SETTID
    CLONE_PARENT_SETTID
    CLONE_CLEAR_SIGHAND
    ...
    +
    parse(raw_flags) : (CloneFlags, i32)
    validate(flags, exit_signal) : Result
}

class WaitOption <<bitflags>> {
    WNOHANG
    WUNTRACED
    WSTOPPED
    WCONTINUED
    WEXITED
    __WALL
    __WCLONE
    WNOWAIT
}

' --- 进程相关类 ---
class Process {
    - inner: Mutex<ProcessInner>
    + pid: usize
    - meta: Mutex<ProcessMeta>
    --
    + new(memory_set, sig_table, fd_table, fs_info, pid, parent_pid): Arc<Self>
    + inner_lock(): MutexGuard<ProcessInner>
    + meta_lock(): MutexGuard<ProcessMeta>
    + ppid(): usize
    + pgid(): usize
    + change_memory_set_and_sigtable(new_ms, new_sig): void
    + exit_and_reparent(): void
    + add_task(task: Arc<TCB>): void
    + all_tasks_exited(): bool
    + basically_exited(): bool
    + remove_from_global_map(pid): void
    {static} + get_process_arc_by_pid(pid) : Option<Arc<Process>>
    {static} - link_child_to_parent(parent, child): void
}

class ProcessInner {
    + memory_set: Arc<RwLock<MemorySet>>
    + sig_table: Arc<Mutex<SigTable>>
    + fd_table: Arc<FdTable>
    + fs_info: Arc<FSInfo>
    + personality: u32
    --
    + get_locked_memory_set_read(): RwLockReadGuard<MemorySet>
    + get_locked_memory_set_write(): RwLockWriteGuard<MemorySet>
    + get_locked_sigtable(): MutexGuard<SigTable>
    + get_abs_path(dirfd, path): Result<String, SysErrNo>
}

class ProcessMeta {
    + tasks: Vec<Weak<TCB>>
    + children: Vec<Weak<Process>>
    + parent_pid: usize
    + pgid: usize
    + child_exit_event: AtomicWaker
    + exit_signal: i32
    + stopped_signal: Option<usize>
    + continued_signal: Option<usize>
    + termination_signal: Option<(usize, bool)>
    + usage: ProcessUsage
}

class ProcessUsage <<value object>> {
    + utime: isize
    + stime: isize
    + cutime: isize
    + cstime: isize
    + maxrss: usize
    + cmaxrss: usize
}

' --- 线程相关类 ---
class TaskControlBlock <<TCB>> {
    - tid: TidHandle
    - kernel_stack: KernelStackOnHeap
    + process: Arc<Process>
    + interrupted: AtomicBool
    + interrupt_waker: AtomicWaker
    - inner: Mutex<TaskControlBlockInner>
    --
    + new(elf_data): Arc<Self>
    + clone_process(flags, exit_signal, stack, parent_tid, tls, child_tid): Result<Arc<Self>>
    + exec(elf_data, argv, env): Result<(), ()>
    + inner_lock(): MutexGuard<TCBInner>
    + tid(): usize
    + pid(): usize
    + ppid(): usize
    + set_status(status: TaskStatus): void
    + poll_interrupt(cx): Poll<()>
    + interrupt(): void
    + clear_interrupt(): void
    + growproc(grow_size): usize
    + check_timer(): void
    - alloc_user_res(inner): usize
    - alloc_trap_context_only(inner): void
}

class TaskControlBlockInner <<TCBInner>> {
    + trap_cx_ppn: PhysPageNum
    + trap_cx_bottom: usize
    + task_cx: TaskContext
    + task_status: TaskStatus
    + time_data: TimeData
    + user_heappoint: usize
    + user_heapbottom: usize
    + clear_child_tid: usize
    + vfork_wait_child: usize
    + sig_mask: SigSet
    + sig_pending: SigSet
    + robust_list: RobustListHead
    + futex_key: usize
    + futex_pa: usize
    + timer: Arc<Timer>
    + user_id: usize
    + effective_uid: u32
    + capabilities: CapabilitySets
    + nice: i32
    ...
    --
    + trap_cx(): &mut TrapContext
    + is_zombie(): bool
}

class TidHandle <<RAII>> {
    + 0: usize
    --
    {static} + alloc(): Option<Self>
    <<Deref>> usize
}

note right of TidHandle::Drop
  zombie 状态保留 PID
  不立即回收
  由 IDLE 控制流统一回收
end note

class KernelStackOnHeap {
    --
    + new(): Self
    + top(): usize
}

class TaskContext <<C ABI>> {
    + ra: usize
    + sp: usize
    + s: [usize; 12]
    --
    {static} + zero_init(): Self
    {static} + goto_trap_return(kstack_top): Self
}

class RobustListHead {
    + list: usize
    + futex_offset: isize
    + list_op_pending: usize
}

' --- 调度器相关类 ---
class TaskManager <<singleton>> {
    {static} - TID_TO_TASK: BTreeMap<usize, Arc<TCB>>
    {static} - PID_2_PROCESS_ARC: BTreeMap<usize, Arc<Process>>
    --
    {static} + tid2task(tid): Option<Arc<TCB>>
    {static} + insert(tid, task): void
    {static} + remove(tid): void
    {static} + get_all_tasks(): Vec<(usize, Arc<TCB>)>
    {static} + task_num(): usize
}

class ReadyQueue <<module>> {
    {static} - READY_QUEUE: VecDeque<Weak<TCB>>
    --
    {static} + add_task(task: &Arc<TCB>): void
    {static} + fetch_task(): Option<Arc<TCB>>
    {static} + ready_procs_num(): usize
    - task_in_queue(queue, task): bool
}

class Processor <<per-Hart>> {
    + current: Option<Arc<TCB>>
    + idle_task_cx: Option<Box<TaskContext>>
    --
    + take_current(): Option<Arc<TCB>>
    + current(): Option<Arc<TCB>>
    - get_idle_task_cx_ptr(): *mut TaskContext
}

class IdAllocator {
    - next_id: usize
    - recycled: Vec<usize>
    --
    + new(start_id): Self
    + alloc(): Option<usize>
    + dealloc(id): void
}

class FutexQueue {
    {static} - FUTEX_QUEUE_BITMAP: HashMap<PhysAddr, Vec<FutexWaiter>>
    --
    {static} + futex_wake_up(pa, count): usize
    {static} - futex_queue_wait(pa, key): void
}

' --- 外部依赖（简略表示） ---
class MemorySet <<external>> {
    areas: Vec<MapArea>
    page_table: PageTable
    --
    activate()
    recycle_data_pages()
    remove_area_with_start_vpn()
    translate_va()
    from_existed_user()
    from_elf()
    lazy_clone_area()
    clone_area()
}

class SigTable <<external>> {
    actions: [KSigAction; 64]
    exit_code: i32
    --
    is_exited()
    set_exit_code()
    exit_code()
    action(signo)
}

class FdTable <<external>> {
    table: Vec<Option<FileDescriptor>>
    --
    clear()
    close_on_exec()
}

class FSInfo <<external>> {
    cwd: String
    exe: String
    --
    get_cwd()
    set_exe()
    clear()
}

class TimeData <<external>> {
    utime, stime, cutime, cstime, cmaxrss
}

class TrapContext <<external>> {
    x: [usize; 32]
    sepc, sstatus
    kernel_stack
    --
    app_init_context(entry, sp, kstack_top)
    set_a0(), set_a1(), set_a2()
    set_sp(), set_tp()
}

class Timer <<external>> {
    it_value, it_interval
    --
    trigger_once()
    last_time()
    set_trigger_once()
}

class AtomicWaker <<external>> {
    register(waker)
    wake()
}

' --- 关系 ---
Process *-- ProcessInner : "1"       composed of
Process *-- ProcessMeta : "1"       composed of
ProcessMeta o-- ProcessUsage : "1"  usage freeze
ProcessMeta o--> "0..*" TaskControlBlock : tasks (Weak)
ProcessMeta o--> "0..*" Process : children (Weak)
ProcessInner o--> "1" MemorySet : Arc<RwLock<>>
ProcessInner o--> "1" SigTable : Arc<Mutex<>>
ProcessInner o--> "1" FdTable : Arc<>
ProcessInner o--> "1" FSInfo : Arc<>

TaskControlBlock *-- TaskControlBlockInner : "1" inner (Mutex)
TaskControlBlock --> "1" TidHandle : tid
TaskControlBlock --> "1" Process : process (Arc)
TaskControlBlock --> "1" KernelStackOnHeap
TaskControlBlockInner --> "1" TaskContext : task_cx
TaskControlBlockInner --> "1" TaskStatus
TaskControlBlockInner --> "1" TimeData
TaskControlBlockInner --> "1" RobustListHead
TaskControlBlockInner --> "0..1" Timer : Arc<>

Process ..> AtomicWaker : child_exit_event uses
TaskControlBlock ..> AtomicWaker : interrupt_waker uses
TaskControlBlockInner ..> TrapContext : trap_cx() returns &mut
ProcessInner ..> MemorySet : lock + delegate

ReadyQueue o--> "0..*" TaskControlBlock : READY_QUEUE (Weak)
TaskManager ..> TaskControlBlock : tid_to_task maps
TaskManager ..> Process : pid_to_process maps
Processor o--> "0..1" TaskControlBlock : current (Arc)
Processor *-- "0..1" TaskContext : idle context

TidHandle ..> IdAllocator : GLOBAL_ID_ALLOCATOR delegates
' Pure Fabrication: TidHandle & IdAllocator are fabricated abstractions

FutexQueue o--> "0..*" TaskControlBlock : waiters (Weak)

note top of TaskControlBlock
  <<GRASP: Creator>>
  clone_process() 采用两阶段创建模式
  Phase 1: 父锁内只读提取数据
  Phase 2: 无锁构造子进程
  避免持有父锁→拿子锁的死锁
end note

note top of ProcessInner
  <<GRASP: Information Expert + High Cohesion>>
  集中管理进程级共享资源:
  memory_set, sig_table, fd_table, fs_info
  锁已下放到资源内部
end note

note bottom of ReadyQueue
  <<GRASP: Controller>>
  统一接口: add_task() / fetch_task()
  封装 FIFO 策略, 防重复插入
end note

note right of IdAllocator
  <<GRASP: Pure Fabrication>>
  通用ID分配器, 不映射领域概念
  recycled栈优先复用, checked_add防溢出
end note

@enduml

@startuml SSD-系统顺序图

' =============================================================================
' 二、SSD (System Sequence Diagram) — 系统顺序图
' 展示用户态程序与内核进程管理子系统之间的高层系统调用交互
' =============================================================================

title 进程管理 — 系统顺序图 (SSD)

actor "用户态程序" as User
participant "内核进程管理\n(Process Management)" as Kernel

== clone / clone3 — 创建线程/进程 ==
User -> Kernel: clone(flags, stack, parent_tid, child_tid, tls)
activate Kernel
Kernel --> User: tid (新线程/进程ID)
deactivate Kernel

note right of Kernel
  clone3 使用结构体传参后
  复用 clone 的核心逻辑
end note

== execve — 加载执行新程序 ==
User -> Kernel: execve(path, argv, envp)
activate Kernel
Kernel -> Kernel: 解析 ELF / shebang 回退
Kernel -> Kernel: 构建新地址空间 + 用户栈
Kernel -> Kernel: 替换 ProcessInner.memory_set
Kernel --> User: 0 (成功; 不返回则新程序接管)
deactivate Kernel

== exit / exit_group — 退出 ==
User -> Kernel: exit(exit_code)
activate Kernel
Kernel -> Kernel: 清理线程资源
Kernel -> Kernel: Zombie + reparent
Kernel -> Kernel: 调度下一个任务 (不返回)
note right: 不返回给调用者

User -> Kernel: exit_group(exit_code)
Kernel -> Kernel: 向兄弟线程发 SIGKILL
Kernel -> Kernel: exit_current_and_run_next
note right: 不返回给调用者

== wait4 / waitid — 等待子进程 ==
User -> Kernel: wait4(pid, status, options)
activate Kernel
Kernel -> Kernel: 扫描 children 列表
alt 找到 Zombie 子进程
    Kernel --> User: child_pid (status已写入)
else WNOHANG 且无符合条件的子进程
    Kernel --> User: 0
else 阻塞等待
    Kernel -> Kernel: 注册 child_exit_event.waker
    Kernel -> Kernel: schedule() 切换任务
    note right: 子进程 exit 时通过\nAtomicWaker 唤醒父进程
    Kernel --> User: child_pid
end
deactivate Kernel

== schedule / sched_setaffinity — 调度控制 ==
User -> Kernel: sched_setaffinity(pid, cpuset)
Kernel --> User: 0

User -> Kernel: sched_getaffinity(pid, cpuset)
Kernel --> User: 0

@enduml

@startuml 交互图-clone流程

' =============================================================================
' 三、交互图 (Interaction Diagram) — clone 两阶段创建
' =============================================================================

title clone 系统调用 — 两阶段创建交互图

participant "用户态" as User
participant "sys_clone\n(clone.rs)" as SysClone
participant "current_task\n(TCB: Arc<Self>)" as Parent
participant "Process\n(父进程)" as ParentProc
participant "IdAllocator" as Alloc
participant "TidHandle\n(新)" as NewTid
participant "新 TCB\n(child)" as Child
participant "新 Process\n(子进程)" as ChildProc
participant "ReadyQueue" as RQ

User -> SysClone: clone(flags, stack, parent_tid, child_tid, tls)
activate SysClone
SysClone -> SysClone: parse_clone_flags(raw)
SysClone -> SysClone: validate_clone_flags

SysClone -> Parent: clone_process(flags, exit_signal, stack, parent_tid, tls, child_tid)
activate Parent

' === Phase 1: 父进程锁内只读提取 ===
group Phase 1: 父进程锁内 (只读提取, 不碰子进程锁)
    Parent -> Parent: lock self.inner
    Parent -> ParentProc: lock process.inner

    Parent -> ParentProc: 提取 memory_set (Arc::clone or COW)
    note right: CLONE_VM? Arc::clone : from_existed_user(COW)
    Parent -> ParentProc: 提取 fd_table (CLONE_FILES? Arc::clone : copy)
    Parent -> ParentProc: 提取 sig_table (CLONE_SIGHAND? Arc::clone : copy)
    Parent -> ParentProc: 提取 fs_info (CLONE_FS? Arc::clone : copy)
    Parent -> Parent: 提取 Copy 字段\n(user_heappoint, sig_mask, uid/gid,\ncapabilities, nice...)
    Parent -> Parent: 提取 trap_cx (*copy)
    Parent -> ParentProc: CLONE_PARENT_SETTID: 写入父地址空间

    Parent -> Alloc: TidHandle::alloc()
    activate Alloc
    Alloc -> NewTid: new TID
    deactivate Alloc

    Parent -> ParentProc: 确定 pid归属\n(CLONE_THREAD? pid=父pid : pid=新tid)
    Parent -> ParentProc: 确定 child_ppid\n(CLONE_PARENT? 祖父 : 父)

    Parent -> ParentProc: unlock
    Parent -> Parent: unlock
end

' === Phase 2: 无锁构造 ===
group Phase 2: 无锁状态 (安全获取任意顺序锁)
    Parent -> Child: 构造 TaskControlBlock\n{ tid, kernel_stack, process, inner }
    activate Child
    note right: inner 中 Copy 字段从 Phase1 填入

    Child -> ChildProc: meta_lock().tasks.push(Arc::downgrade(&child))
    Child -> Child: inner_lock()

    alt CLONE_THREAD
        alt stack != 0
            Child -> Child: alloc_trap_context_only() (用户提供栈)
        else stack == 0
            Child -> Child: alloc_user_res() (分配新栈+TC)
        end
        Child -> Child: *trap_cx = parent_trap_cx
        Child -> Child: trap_cx.set_a0(0)
    else fork (非线程)
        Child -> Child: alloc_user_res()
        Child -> ParentProc: 读取父内存
        Child -> ChildProc: clone_area (COW复制数据页)
        Child -> Child: *trap_cx = parent_trap_cx; trap_cx.set_a0(0)
    end

    alt stack != 0
        Child -> Child: trap_cx.set_sp(stack)
    end
    alt CLONE_SETTLS
        Child -> Child: trap_cx.set_tp(tls)
    end
    alt CLONE_CHILD_SETTID
        Child -> ChildProc: 写入子进程地址空间 (child_tid = tid)
    end

    alt !CLONE_THREAD
        Child -> ChildProc: meta_lock().exit_signal = exit_signal
        Child -> ChildProc: create_proc_dir_and_file (procfs)
    end

    alt CLONE_VFORK
        Parent -> Parent: inner_lock()
        Parent -> Parent: vfork_wait_child = child.tid()
        Parent -> Parent: task_status = VforkBlocked
        Parent -> Parent: unlock
    end

    Child -> Child: unlock inner
end

Parent -> Parent: tid_to_task::insert(tid, &child)
Parent --> SysClone: Ok(child)
deactivate Parent

SysClone -> RQ: ready_queue::add_task(&child)
SysClone --> User: Ok(child_tid)
deactivate SysClone

note over Parent, Child
    <<GRASP: Creator — 两阶段创建>>
    Phase 1 (锁内): 只提取数据, 不获取子进程锁 → 避免死锁
    Phase 2 (无锁): 安全构造, 可任意顺序获取锁
end note

@enduml

@startuml 交互图-execve流程
' 交互图 — execve 系统调用流程
title execve 系统调用交互图

participant "用户态" as User
participant "sys_execve\n(execve.rs)" as SysExec
participant "ProcessInner\n(当前)" as ProcInner
participant "MemorySet\n(旧)" as OldMS
participant "FSInfo\n(当前)" as FS
participant "VFS\n(文件系统)" as VFS
participant "MemorySetInner\n::from_elf()" as ELFLoader
participant "TCB::exec()\n(当前任务)" as Task
participant "TrapContext\n(新)" as TrapCx
participant "FdTable\n(当前)" as FdTab
participant "处理器\n调度器" as Scheduler

User -> SysExec: execve(path, argv, envp)
activate SysExec

SysExec -> ProcInner: get_locked_memory_set_read()
SysExec -> ProcInner: read_user_cstr(path)
SysExec -> ProcInner: copy argv[] and envp[] from user space

SysExec -> FS: get_cwd() -> 拼接绝对路径
SysExec -> FS: 特殊处理 /proc/self/exe -> 替换为真正 exe 路径

SysExec -> VFS: open(abs_path, O_RDONLY)
VFS --> SysExec: inode
SysExec -> VFS: inode.read_all() -> elf_data

alt 非 ELF 文件
    SysExec -> SysExec: parse_shebang(data) 检测 #! 行
    alt shebang 存在 (如 #!/bin/sh)
        SysExec -> SysExec: 重建 argv: [解释器, 脚本路径, 原参数...]
        SysExec -> VFS: open(解释器路径) -> 加载解释器 ELF
    else 无 shebang
        SysExec --> User: Err(ENOEXEC)
    end
end

SysExec -> FS: set_exe(abs_path)
SysExec -> ProcInner: drop locks

SysExec -> Task: exec(&elf_data, &argv, &mut env)
activate Task

Task -> Task: inner_lock()

' 在替换地址空间前处理 CLONE_CHILD_CLEARTID
alt clear_child_tid != 0
    Task -> OldMS: get_locked_memory_set_read()
    Task -> OldMS: copy_to_user(clear_child_tid, [0u8; 4])
    Task -> OldMS: translate_va(clear_child_tid) -> pa
    Task -> Task: futex_wake_up(pa, 1) 唤醒等待者
    Task -> Task: clear_child_tid = 0
    note right of Task: <<Information Expert>>\n只有 exec() 同时持有\n旧地址空间引用和\nclear_child_tid 值
end

' VFORK: 唤醒父进程
Task -> Task: 遍历父进程 tasks,\n若 vfork_wait_child==self.tid 则唤醒

' 核心: 加载新程序
Task -> ELFLoader: MemorySetInner::from_elf(elf_data)
activate ELFLoader
ELFLoader -> ELFLoader: 解析 ELF header, LOAD 段
ELFLoader -> ELFLoader: 映射 .text (R+X), .rodata (R), .data (R+W)
ELFLoader -> ELFLoader: 处理 INTERP (动态链接器)
ELFLoader --> Task: (memory_set, user_hp, entry_point, auxv)
deactivate ELFLoader

Task -> ProcInner: change_memory_set_and_sigtable(new_ms, new_sig)
note right of Task: <<Indirection>>\nArc替换, 旧MS由引用计数自动回收

Task -> Task: alloc_user_res() 重新分配栈+TrapContext
Task -> FdTab: close_on_exec() 关闭 O_CLOEXEC fd

' 构建用户栈 (argv, envp, auxv)
Task -> Task: 环境变量 strings 入栈
Task -> Task: 参数 strings 入栈
Task -> Task: auxv (AT_PHDR, AT_ENTRY, AT_PAGESZ, AT_RANDOM...) 入栈
Task -> Task: envp[] 指针数组入栈
Task -> Task: argv[] 指针数组入栈
Task -> Task: argc 入栈

Task -> TrapCx: app_init_context(entry_point, user_sp, kstack_top)
Task -> TrapCx: set_a0(argc), set_a1(argv_base), set_a2(envp_base)
Task -> Task: user_heappoint = user_hp

Task -> Task: unlock inner
Task --> SysExec: Ok(())
deactivate Task

SysExec --> User: Ok(0)
note right of User: 返回用户态后\n新程序开始执行
deactivate SysExec

note over OldMS, ELFLoader
    <<GRASP: Protected Variations>>
    MemorySetInner::from_elf() 封装 ELF 加载细节
    shebang 机制扩展了可执行格式支持
    未来支持新格式只需提供替代构造器
end note

@enduml

@startuml 交互图-exit流程
' 交互图 — exit 系统调用流程
title exit 系统调用交互图 (exit_current_and_run_next)

participant "当前任务\n(curr_task)" as Task
participant "TaskControlBlock\nInner" as TCBInner
participant "Process\n(curr_proc)" as Proc
participant "MemorySet" as Mem
participant "FdTable" as FdTab
participant "兄弟线程\n(bro_tasks)" as Bro
participant "FUTEX_QUEUE\n_BITMAP" as FutexQ
participant "父进程\n(parent)" as Parent
participant "initproc\n(pid=1)" as Init
participant "ReadyQueue" as RQ
participant "IDLE控制流" as Idle

-> Task: exit_current_and_run_next(exit_code)
activate Task

Task -> Task: take_current_task()
Task -> Proc: process.inner_lock()
Task -> Mem: get_locked_memory_set_read()
Task -> TCBInner: inner_lock()

' 1. CLONE_CHILD_CLEARTID
group 步骤1: CLONE_CHILD_CLEARTID
    alt clear_child_tid != 0
        Task -> Mem: copy_to_user_val(clear_child_tid, 0)
        Task -> Mem: translate_va(clear_child_tid)
        Task -> Task: futex_wake_up(pa, 1)
        note right: 唤醒等在 child_tid 的线程
    end
end

' 2. Robust List
group 步骤2: Robust List 处理
    Task -> TCBInner: 遍历 robust_list
    loop 每个 robust futex
        Task -> Task: handle_futex_when_exit()
        note right: FUTEX_OWNER_DIED + FUTEX_WAITERS\n唤醒等待者
    end
end

' 3. VFORK 唤醒父进程
group 步骤3: VFORK 唤醒父进程
    Task -> Parent: get_process_arc_by_pid(ppid())
    loop 遍历 parent.tasks
        alt vfork_wait_child == self.tid
            Task -> Task: parent_inner.vfork_wait_child = 0
            Task -> Task: parent_inner.task_status = Ready
            Task -> RQ: add_task(&parent_task)
        end
    end
end

' 4-5. 回收线程资源
group 步骤4-5: 线程资源回收
    Task -> Mem: remove_area (TrapContext区域)
    Task -> TCBInner: task_status = Zombie
    note left: KernelStackOnHeap\n在 TCB Drop 时自动回收
end

' 6. 唤醒兄弟线程
group 步骤6: 兄弟线程唤醒 (防死锁)
    Task -> Proc: meta_lock().tasks.clone()
    loop 每个阻塞的兄弟线程
        Task -> Bro: inner_lock()
        Task -> TCBInner: 记录 futex_key / futex_pa
        Task -> Bro: task_status = Ready
        Task -> Bro: futex_key = 0; futex_pa = 0
        Task -> Bro: unlock
        alt futex_key != 0
            Task -> FutexQ: lock → 从 wait_queue 移除条目
            note right
                <<Low Coupling>>
                避免后续 futex_wake
                基于已清理字段
                错误地再次唤醒
            end note
        end
        Task -> RQ: add_task(&bro)
    end
end

' 7. 进程级回收 (全部线程 Zombie 时)
group 步骤7: 进程级回收
    Task -> Task: 检查 all_tasks_exited()
    alt 所有线程均为 Zombie
        Task -> Proc: 收集 usage\n(utime, stime, cutime, maxrss...)
        Task -> Mem: recycle_data_pages()
        Task -> FdTab: fd_table.clear()
        Task -> Proc: fs_info.clear()
        Task -> Proc: sigtable.set_exit_code(exit_code)

        ' Reparent 孤儿
        Task -> Proc: exit_and_reparent()
        activate Proc
        Proc -> Proc: 收集所有 children (filter_map upgrade)
        Proc -> Init: get_process_arc_by_pid(1)
        loop 每个孤儿
            Proc -> Init: 孤儿.parent_pid = 1
            Proc -> Init: initproc.children.push(孤儿)
        end
        Proc -> Init: send_signal(SIGCHLD)
        deactivate Proc
        note right
            <<Information Expert>>
            Process 拥有 children
            自然承担孤儿转移职责
        end note

        ' 通知父进程
        Task -> Proc: 读取 exit_signal
        alt exit_signal >= 0
            Task -> Parent: send_signal_to_thread_group(ppid, SIGCHLD)
        end
        Task -> Parent: child_exit_event.wake()
        note right
            <<Indirection>>
            AtomicWaker 解耦:
            子进程无需知晓父进程身份
            仅通过 wake() 通知
        end note
    end
end

' 8. 移交 IDLE
group 步骤8: 移交 IDLE 控制流
    Task -> Mem: drop memory_set
    Task -> Proc: drop process lock
    Task -> Task: drop(curr_task)
    Task -> Task: activate_kernel_space() (切换到内核页表)
    Task -> Idle: abandon(tid)  — 不返回!
    activate Idle
    Idle -> Idle: tid_to_task::remove(tid)
    Idle -> Idle: drop TCB (最后的 Arc 引用)
    Idle -> Idle: TidHandle::drop (延迟回收TID)
    Idle -> RQ: fetch_task() → 下一个任务
    deactivate Idle
end

@enduml

@startuml 交互图-wait4流程

' 交互图 — wait4 系统调用流程
title wait4 系统调用交互图

participant "用户态" as User
participant "sys_waitpid\n(wait.rs)" as SysWait
participant "当前任务\n(current_task)" as Task
participant "ProcessMeta\n(父进程)" as Meta
participant "子进程\n(child: Process)" as Child
participant "Child SigTable" as ChildSig
participant "ProcessInner\n(父)" as ProcInner
participant "信号检查\n(check_if_any_sig)" as SigCheck
participant "AtomicWaker\n(child_exit_event)" as Waker
participant "Scheduler\n(调度器)" as Sched

User -> SysWait: wait4(pid, wstatus, options)
activate SysWait

SysWait -> SysWait: 解析 pid → WaitPid 枚举
note right: pid>0 → Pid\npid==0 → Pgid(self)\npid==-1 → Any\npid<-1 → Pgid(-pid)

SysWait -> SysWait: WaitOption::from_bits_truncate(options)
SysWait -> SysWait: block_on(interruptible(poll_fn(...)))

loop poll_fn 轮询
    SysWait -> Task: current_task()
    SysWait -> Meta: meta_lock()

    ' 扫描子进程
    SysWait -> Meta: 遍历 children (filter_map upgrade)
    note right
    过滤条件:
    1. wait_pid.apply(child)
    2. __WALL / __WCLONE / exit_signal==SIGCHLD
    end note
    alt children 为空
        SysWait --> User: Err(ECHILD)
    end

    ' 检查 WSTOPPED (SIGSTOP/SIGTSTP)
    alt stopped_signal 存在
        SysWait -> Child: found! stopped_pid
        SysWait -> ProcInner: get_locked_memory_set_read()
        SysWait -> ProcInner: copy_to_user(wstatus, (signal<<8)|0x7f)
        SysWait -> Meta: child.stopped_signal = None
        SysWait --> User: Ok(found_pid)
    end

    ' 检查 WEXITED (Zombie)
    alt 找到 Zombie 子进程
        SysWait -> Child: found! zombie_pid
        SysWait -> ChildSig: exit_code()
        SysWait -> Meta: child_meta.usage (冻结的快照)
        SysWait -> ProcInner: copy_to_user(wstatus, exit_code编码)
        note right
        退出码编码:
        exit_code>=128..=255 → exit_code
        否则 → exit_code << 8
        end note    
        alt !WNOWAIT (正常回收)
            SysWait -> Task: 累计 child_usage\n→ time_data.{c}utime/stime
            SysWait -> Meta: children.remove(idx) (从列表移除)
            SysWait -> Child: Process::remove_from_global_map(pid)
            note right: 移除 /proc 目录
            SysWait -> Child: drop(child) → TCB 引用释放
        end

        SysWait --> User: Ok(found_pid)
    end

    ' WNOHANG: 立即返回
    alt WNOHANG
        SysWait --> User: Ok(0)
    end

    ' 阻塞等待前: 信号检查
    SysWait -> SigCheck: check_if_any_sig_for_current_task()
    alt 有待决信号
        alt SIGCHLD / 忽略信号 / 默认 Ignore
            SysWait -> Task: sig_pending.remove(signal)
            note right: 消费信号, 继续 poll
        else 自定义 handler 且 SA_RESTART
            SysWait -> Task: sig_pending.remove(signal)
            note right: 消费信号, 继续 poll
        else 自定义 handler 无 SA_RESTART
            SysWait --> User: Err(EINTR)
        else 默认 Term/Core 无 handler
            note right: 保持信号, 继续等待
        end
    end

    ' 注册等待
    SysWait -> Waker: child_exit_event.register(cx.waker())
    note right
        <<Indirection — AtomicWaker>>
        解耦: 子进程 exit 时
        仅调用 wake(), 不知父进程身份
    end note
    SysWait -> Meta: unlock
    SysWait -> Task: drop

    SysWait -> Sched: 返回 Poll::Pending → schedule()
    note right
        阻塞: 交出 CPU
        等待子进程 exit 时
        child_exit_event.wake() 唤醒
    end note
end

@enduml

@startuml 活动图-clone创建流程
' 四、活动图 — clone 两阶段创建
title clone 系统调用活动图 — 两阶段创建模式
|系统调用模块|
start
:解析 raw_flags → (CloneFlags, exit_signal);
:校验 clone_flags 合法性;

if (flags 非法?) then (是)
    :返回 EINVAL;
    stop
endif

:获取 current_task();

|Phase 1: 父进程锁内|
#LightBlue:锁定 self.inner + process.inner;

if (CLONE_VM?) then (是)
    :memory_set = Arc::clone(父);
else (否)
    :memory_set = from_existed_user(COW 复制);
endif

if (CLONE_FILES?) then (是)
    :fd_table = Arc::clone(父);
else (否)
    :fd_table = FdTable::from_another(父);
endif

if (CLONE_SIGHAND?) then (是)
    :sig_table = Arc::clone(父);
elseif (CLONE_CLEAR_SIGHAND?) then (是)
    :sig_table = SigTable::new();
else (否)
    :sig_table = SigTable::from_another(父);
endif

if (CLONE_FS?) then (是)
    :fs_info = Arc::clone(父);
else (否)
    :fs_info = FSInfo::from_another(父);
endif

:提取父进程 inner 的 Copy 字段\n(user_heappoint, sig_mask, uid/gid, capabilities, nice...);
:提取父进程 trap_cx 副本;
:TidHandle::alloc() 分配新 TID;

if (CLONE_THREAD?) then (是)
    :child_pid = 父pid;
    :child_ppid = 父ppid;
    :process = 父process.clone();
else (否)
    :child_pid = 新tid;
    if (CLONE_PARENT?) then (是)
        :child_ppid = 祖父pid;
    else (否)
        :child_ppid = 父pid;
    endif
    :process = Process::new();
endif

if (CLONE_PARENT_SETTID?) then (是)
    :写入父地址空间 parent_tid = 新tid;
endif

:释放 self.inner + process.inner 锁;

|Phase 2: 无锁构造|
#LightGreen:构造子进程 TCB;

:Process.meta_lock().tasks.push(子TCB);

:alloc_user_res() 分配栈和 TrapContext;

if (CLONE_THREAD?) then (是)
    if (stack != 0?) then (是)
        :alloc_trap_context_only()\n(用户提供线程栈);
    else (否)
        :alloc_user_res()\n(分配新栈);
    endif
    :*trap_cx = 父trap_cx;
else (fork 非线程)
    :alloc_user_res();
    :clone_area (COW 复制数据页);
    :*trap_cx = 父trap_cx;
endif

:trap_cx.set_a0(0);\n(子进程返回 0);

if (stack != 0?) then (是)
    :trap_cx.set_sp(stack);
endif

if (CLONE_SETTLS?) then (是)
    :trap_cx.set_tp(tls);
endif

if (CLONE_CHILD_SETTID?) then (是)
    :写入子地址空间 child_tid = 新tid;
endif

if (!CLONE_THREAD?) then (是)
    :设置 exit_signal;
    :create_proc_dir_and_file (procfs);
endif

if (CLONE_VFORK?) then (是)
    :父进程 vfork_wait_child = 子tid;
    :父进程 task_status = VforkBlocked;
endif

:tid_to_task::insert(子tid, 子TCB);

:ready_queue::add_task(&child);

:返回 child.tid;
stop
@enduml

@startuml 活动图-execve流程
title execve 系统调用活动图 (基于对象职责划分)

' 定义执行主体（对象/模块）作为泳道
|#Application|系统调用/进程管理 (Process)|
|#LightBlue|文件系统 (VFS)|
|#LightYellow|内存管理器 (MemorySet)|

' --- 流程开始 ---
|系统调用/进程管理 (Process)|
start
:从用户态拷贝 path, argv, envp;
:获取绝对路径 (cwd + path);
:特殊处理 /proc/self/exe → 替换为真实 exe;

|文件系统 (VFS)|
:VFS open(path, O_RDONLY);
:读取文件内容 → data;

|系统调用/进程管理 (Process)|
if (data 是 ELF?) then (是)
    #LightGreen:ELF 路径;
else (否)
    if (有 shebang #!?) then (是)
        :解析 shebang 行;
        :提取解释器路径 + 可选参数;
        :重建 argv:
        [解释器, 可选参数, 脚本路径, 原参数...];
        |文件系统 (VFS)|
        :VFS open(解释器路径);
        :读取解释器 ELF → data;
        |系统调用/进程管理 (Process)|
        if (解释器是 ELF?) then (是)
            #LightGreen:间接 ELF 路径;
        else (否)
            :返回 ENOEXEC;
            stop
        endif
    else (否)
        :返回 ENOEXEC;
        stop
    endif
endif
:set_exe(abs_path);

|内存管理器 (MemorySet)|
:MemorySetInner::from_elf(&elf_data);
note right
    解析 ELF header
    映射 LOAD 段 (R/W/X 权限)
    处理 INTERP 动态链接器
end note
:构建新 MemorySet;

|系统调用/进程管理 (Process)|
if (clear_child_tid != 0?) then (是)
    |内存管理器 (MemorySet)|
    :旧地址空间中：copy_to_user(clear_child_tid, 0);
    :clear_child_tid = 0;
    |系统调用/进程管理 (Process)|
    :futex_wake_up(pa, 1);
endif

:VFORK: 唤醒阻塞的父进程;
:Process::change_memory_set_and_sigtable(new_ms, new_sig);
note right
    <<Indirection>>
    Arc 替换, 旧 MS 引用计数归零时自动回收
end note

:alloc_user_res() 重新分配栈 + TrapContext;
:fd_table.close_on_exec() 关闭 O_CLOEXEC fd;
:sig_mask = EMPTY;
:sig_pending = EMPTY;

|内存管理器 (MemorySet)|
:环境变量 strings 入栈 (高地址 → 低地址);
:argv strings 入栈;
:auxv 数组入栈
(AT_PHDR, AT_ENTRY, AT_PAGESZ, AT_RANDOM...);
:envp[] 指针数组入栈;
:argv[] 指针数组入栈;
:argc 值入栈;

|系统调用/进程管理 (Process)|
:设置 TrapContext:
    sepc = ELF entry_point
    sp = user_sp
    a0 = argc, a1 = argv_base, a2 = envp_base;
:返回 0 (到新程序入口);
stop
@enduml

@startuml 活动图-exit流程

' =============================================================================
' 活动图 — exit 线程/进程退出
' =============================================================================

title exit 系统调用活动图 — 线程退出与进程回收
|系统|
start

:exit_current_and_run_next(exit_code);

:take_current_task();

|线程级清理|
if (clear_child_tid != 0?) then (是)
    :向 clear_child_tid 写 0;
    :futex_wake_up(pa, 1);
endif

:handle_futex_when_exit()
遍历 robust_list, FUTEX_OWNER_DIED;

if (有 vfork 父进程等待?) then (是)
    :唤醒 vfork 父进程 → Ready;
endif

:remove_area(TrapContext 区域);
:task_status = Zombie;

|兄弟线程处理|
:遍历 process.meta.tasks;

while (还有兄弟线程?) is (是)
    if (兄弟线程是 Blocked?) then (是)
        :记录 futex_key, futex_pa;
        :bro.task_status = Ready;
        :bro.futex_key = 0;
        :bro.futex_pa = 0;
        if (futex_key != 0?) then (是)
            :从 FUTEX_QUEUE_BITMAP 移除;
        endif
        :ready_queue::add_task(&bro);
    endif
endwhile (否)

|进程级回收检查|
if (所有兄弟线程都是 Zombie?) then (是)
    #Orange:进程级回收;

    :收集 usage (utime, stime, cutime, maxrss...);
    :memory_set.recycle_data_pages();
    :fd_table.clear();
    :fs_info.clear();
    :sigtable.set_exit_code(exit_code);

    :exit_and_reparent();
    note right: 孤儿 → initproc(pid=1)
    :send_signal(SIGCHLD) → initproc;

    if (exit_signal >= 0?) then (是)
        :send_signal(SIGCHLD) → 父进程;
    endif

    :parent.child_exit_event.wake();
    note right: <<Indirection — AtomicWaker>>

    :remove_proc_dir_and_file(pid);
endif

|移交 IDLE 控制流|
:drop 所有局部变量;
:activate_kernel_space() 切换到内核页表;

:abandon(tid) → IDLE;
note right: 不返回!
:IDLE 负责:
- tid_to_task::remove(tid)
- drop TCB
- TidHandle::drop
- fetch_task();
stop
@enduml

@startuml 活动图-wait4流程
title wait4 系统调用活动图 (基于对象/组件泳道划分)

|Wait4Syscall|
' 系统调用入口与出口处理
|ProcessManager|
' 进程控制块、子进程链表及状态管理
|SignalModule|
' 信号检查与投递逻辑
|TaskScheduler|
' 协程/线程调度、Waker 注册及阻塞控制

|Wait4Syscall|
start
:解析 pid → WaitPid 枚举;
:解析 options → WaitOption;

|ProcessManager|
:锁定 process_meta;
:检索子进程 (应用 wait_pid 过滤 & exit_signal 筛选);

if (children 链表为空?) then (是)
    |Wait4Syscall|
    :返回 ECHILD 错误;
    stop
endif

:遍历 children 并评估状态;

' 优先级 1: WSTOPPED
if (options & WSTOPPED 且有子进程处于 Stopped 状态?) then (是)
    :写入 status: ((signal << 8) | 0x7f);
    :清除 child.stopped_signal;
    |Wait4Syscall|
    :返回 child.pid;
    stop
endif

' 优先级 2: WCONTINUED
|ProcessManager|
if (options & WCONTINUED 且有子进程处于 Continued 状态?) then (shift)
    :清除 child.continued_signal;
    |Wait4Syscall|
    :返回 child.pid;
    stop
endif

' 优先级 3: WEXITED (Zombie 状态回收)
|ProcessManager|
if (options & WEXITED 且子进程已退出?) then (是)
    :读取退出码 exit_code 并捕获资源使用快照 (child_usage);
    :按照 Linux 规范编码 status 并写入用户空间;
    
    if (options & WNOWAIT?) then (否)
        :累计子进程运行时间至父进程;
        :从父进程 child 链表中移除该子进程;
        :从全局 PID Map 中注销并销毁 TCB 引用;
    endif
    
    |Wait4Syscall|
    :返回 child.pid;
    stop
endif
' WNOHANG 非阻塞立即返回
|ProcessManager|
if (options & WNOHANG?) then (是)
    |Wait4Syscall|
    :返回 0 (无状态改变的子进程);
    stop
endif
' 信号拦截与中断检查
|SignalModule|
if (检查当前进程是否有待决信号?) then (是)
    if (SIGCHLD 或显式忽略/默认 Ignore) then (是)
        :消费并清除该信号;
        note right: 恢复执行, 重新 Poll
    elseif (自定义信号处理函数 且包含 SA_RESTART) then (是)
        :调用信号处理程序;
        note right: 恢复执行, 重新 Poll
    elseif (自定义信号处理函数 且无 SA_RESTART) then (是)
        |Wait4Syscall|
        :中断返回 EINTR;
        stop
    else (默认 Term/Core 等未注册 handler 的信号)
        ' 保持信号不消费
    endif
endif

' 阻塞等待逻辑
|TaskScheduler|
:将当前上下文的 Waker 注册到 child_exit_event;
|ProcessManager|
:解锁 process_meta;
|TaskScheduler|
:当前任务让出 CPU，返回 Poll::Pending;
note right
    **调度器接管**
    当子进程退出触发 child_exit_event.wake() 时，
    当前任务重新被放入就绪队列进行 Poll 轮询。
end note
stop
@enduml

@startuml 操作契约
' 五、操作契约 (Operation Contracts)
' 使用前置条件/后置条件描述关键操作的语义约束
title 进程管理关键操作 — 操作契约
' clone_process
rectangle clone_process [
    <b>Operation:</b> clone_process(flags, exit_signal, stack, parent_tid, tls, child_tid) → Result<Arc<TCB>>

    <b>Cross References:</b> sys_clone, sys_clone3

    <b>Responsibilities:</b>
    根据 CloneFlags 创建新的线程或进程, 确定资源共享策略,
    设置子进程的 TrapContext, 处理 VFORK 父进程阻塞

    <b>Preconditions:</b>
    — current_task 存在且有效
    — CloneFlags 已通过 parse_clone_flags + validate_clone_flags 校验
    — TidHandle::alloc() 成功分配新 TID
    — 父进程 inner 和 process.inner 锁已获取 (Phase 1)
    — 父进程地址空间可访问 (用于 COW 复制和 CLONE_PARENT_SETTID 写入)

    <b>Postconditions (成功):</b>
    — 新 TCB (child) 被创建并返回
    — child.task_status = Ready
    — child.trap_cx 的 sepc 等于父进程 sepc (从同一位置继续执行)
    — child.trap_cx 的 a0 = 0 (子进程返回值)
    — 若 CLONE_VM: child 与父共享 Process (同一 process Arc)
    — 若非 CLONE_VM: child 拥有独立 Process, memory_set 是父的 COW 副本
    — 若 CLONE_FILES: child 与父共享 FdTable (Arc::clone)
    — 若非 CLONE_FILES: child 拥有父 FdTable 的深拷贝
    — 若 CLONE_SIGHAND: child 与父共享 SigTable
    — 若 CLONE_THREAD: child_pid = 父pid, child 加入同一线程组的 tasks
    — 若非 CLONE_THREAD: child_pid = 新pid, 创建 /proc/<pid> 目录
    — 若 CLONE_VFORK: 父进程 task_status = VforkBlocked, vfork_wait_child = child.tid
    — 若 CLONE_SETTLS: trap_cx.tp = tls
    — 若 CLONE_CHILD_SETTID: *child_tid = child.tid (写入子地址空间)
    — 若 CLONE_PARENT_SETTID: *parent_tid = child.tid (写入父地址空间)
    — 若 CLONE_CHILD_CLEARTID: child.clear_child_tid = child_tid as usize
    — child 已插入 tid_to_task 映射表
    — child 未被加入 ready_queue (由调用者 sys_clone 负责)

    <b>Postconditions (失败):</b>
    — 返回对应的 SysErrNo
    — 不发生部分创建: 所有已分配资源在错误路径中通过 Drop 自动回收
    — 父进程状态不变
    — 全局 tid_to_task 和 pid_to_process 映射表不变

    <b>GRASP:</b> Creator — clone_process 是子进程的唯一创建者,
    采用两阶段模式 (Phase1 锁内只读提取 + Phase2 无锁构造) 避免死锁

    <b>Non-functional:</b>
    — 时间: O(1) 基本操作, O(pages) COW 复制
    — 锁策略: Phase1 持有 self.inner + process.inner; Phase2 无锁
    — 安全性: 所有 Arc::clone 操作保证引用计数递增, 无 use-after-free
]
' exec
rectangle exec [
    <b>Operation:</b> TCB::exec(&elf_data, &argv, &mut env) → Result<(), ()>

    <b>Cross References:</b> sys_execve

    <b>Responsibilities:</b>
    加载 ELF 程序替换当前进程的地址空间, 构建新用户栈,
    处理 clear_child_tid 清理, 唤醒 vfork 父进程

    <b>Preconditions:</b>
    — self (当前 TCB) 有效且 task_status = Running
    — elf_data 是经过 ELF 魔数校验的有效 ELF 文件内容
    — (shebang 回退已在 sys_execve 中处理)
    — argv 和 env 已完成从用户态的拷贝 (在 sys_execve 中)

    <b>Postconditions (成功):</b>
    — ProcessInner.memory_set 被替换为新的 MemorySet (旧 MS 由 Arc 自动回收)
    — ProcessInner.sig_table 被替换为新的 SigTable
    — 新 MemorySet 包含: ELF .text (R+X) / .rodata (R) / .data (R+W) 段
    — 若 ELF 有 INTERP: 动态链接器被加载
    — 新用户栈包含: argc, argv[], envp[], auxv[]
    — trap_cx.sepc = ELF entry_point
    — trap_cx.sp = 新用户栈顶
    — trap_cx.a0 = argc, a1 = argv_base, a2 = envp_base
    — 若 clear_child_tid != 0: 旧地址空间中已完成写 0 + futex_wake
    — clear_child_tid = 0 (exec 后不再有效)
    — 若 VFORK 父进程等待: 父进程被唤醒 (task_status = Ready, 加入就绪队列)
    — fd_table.close_on_exec() 已执行: O_CLOEXEC fd 已关闭
    — sig_mask = EMPTY, sig_pending = EMPTY
    — time_data 已清零 (重新计时)
    — 成功时返回 Ok(()), sys_execve 返回 0 到新程序入口

    <b>Postconditions (失败):</b>
    — 若 from_elf 失败 (OOM): 返回 Err(()), sys_execve 返回 ENOMEM
    — 调用者的地址空间和进程状态未被修改
    — 文件描述符不受影响 (close_on_exec 在成功路径才执行)
]

' ====================================
' exit_current_and_run_next
' ====================================
rectangle exit_current_and_run_next [
    <b>Operation:</b> exit_current_and_run_next(exit_code: i32) → !

    <b>Cross References:</b> sys_exit, sys_exit_group (经由 exit_current_group_and_run_next)

    <b>Responsibilities:</b>
    终止当前线程, 清理线程资源, 必要时执行进程级回收,
    向 IDLE 控制流移交 TCB 所有权

    <b>Preconditions:</b>
    — current_task 存在且可通过 take_current_task() 取出
    — curr_task 的强引用计数期望 ≤ 2 (超过则发出 warning)
    — 当前执行在内核态 (S-mode)

    <b>Postconditions (副作用, 不返回):</b>
    — curr_task 已从 Processor.current 移除
    — curr_task.task_status = Zombie
    — curr_task.trap_cx 区域已从 memory_set 移除
    — 若 clear_child_tid != 0: 用户态 *clear_child_tid = 0, futex_wake 已执行
    — robust_list 中的所有 futex 已完成 FUTEX_OWNER_DIED 处理
    — VFORK 父进程 (如有) 已唤醒
    — 阻塞的兄弟线程已从 FUTEX_QUEUE_BITMAP 移除并唤醒加入就绪队列
    — 若所有线程 Zombie:
        — memory_set.recycle_data_pages() 已执行
        — fd_table.clear() 已执行
        — sigtable.exit_code = exit_code
        — 孤儿进程已 reparent 到 initproc (pid=1)
        — 向父进程发送了 SIGCHLD (若 exit_signal >= 0)
        — parent.child_exit_event.wake() 已调用
        — /proc/<pid> 已移除
        — ProcessUsage 已冻结到 process.meta.usage
    — 内核页表已激活 (activate_kernel_space)
    — 控制流已通过 abandon(tid) 转交给 IDLE
    — IDLE 将调用 tid_to_task::remove(tid) 并 drop TCB

    <b>Postconditions (不变量):</b>
    — 全局 tid_to_task 映射表一致性: 仅由 IDLE 移除条目
    — PID_2_PROCESS_ARC 一致: 仅由 Process::remove_from_global_map 移除 (在 wait4 回收后)
    — 无僵尸进程泄漏: 所有子进程已 reparent 或已通知父进程
]

' ====================================
' wait4
' ====================================
rectangle wait4 [
    <b>Operation:</b> sys_waitpid(pid, wstatus, options) / sys_waitid(idtype, id, infop, options) → SyscallRet

    <b>Cross References:</b> sys_wait4

    <b>Responsibilities:</b>
    等待子进程状态变化 (退出/停止/继续), 回收 Zombie 子进程

    <b>Preconditions:</b>
    — current_task 存在且有效
    — pid 参数已按 POSIX 语义解析为 WaitPid 枚举 (Pid/Pgid/Any)
    — options 已转换为 WaitOption bitflags
    — 调用者持有当前任务的隐式引用 (在系统调用上下文中)

    <b>Postconditions (找到 Zombie 子进程, 非 WNOWAIT):</b>
    — *wstatus 已写入退出状态 (Linux 兼容编码)
    — child 已从 process_meta.children 移除
    — child 已从 PID_2_PROCESS_ARC 全局映射移除
    — /proc/<pid> 已移除
    — 父进程 time_data.{c}utime/{c}stime 已累计 child_usage
    — child TCB 的最后一个强引用已释放 (包括 TidHandle)
    — 返回 child.pid

    <b>Postconditions (WNOWAIT / WSTOPPED / WCONTINUED):</b>
    — 状态信息已写入 *wstatus 或 *infop
    — 子进程 NOT 被回收 (仍在 children 列表中)
    — 若 WSTOPPED: stopped_signal 被清除 (非 WNOWAIT 时)
    — 若 WCONTINUED: continued_signal 被清除 (非 WNOWAIT 时)

    <b>Postconditions (WNOHANG 无符合条件的子进程):</b>
    — 返回 0
    — 若 infop 非空: 清零 infop

    <b>Postconditions (阻塞等待中):</b>
    — process_meta 锁已释放
    — child_exit_event 已注册当前任务的 waker
    — 当前任务已通过 schedule() 切出 CPU (状态可能是 Blocked)
    — 当子进程 exit 时: child_exit_event.wake() 唤醒本任务重新 poll

    <b>Postconditions (信号中断):</b>
    — 若待决信号是 SIGCHLD/忽略/默认 Ignore: 信号被消费, 继续等待
    — 若自定义 handler 且 SA_RESTART: 信号被消费, 继续等待
    — 若自定义 handler 无 SA_RESTART: 返回 EINTR
    — 若无可等待子进程: 返回 ECHILD
]

' ====================================
' schedule
' ====================================
rectangle schedule [
    <b>Operation:</b> schedule(switched_task_cx_ptr: *mut TaskContext) → !

    <b>Cross References:</b> suspend_current_and_run_next, block_current_and_run_next

    <b>Responsibilities:</b>
    保存当前任务的上下文, 切换到 Processor 的 idle 控制流,
    idle 控制流继续 run_tasks() 循环取下一任务

    <b>Preconditions:</b>
    — 当前任务已通过 take_current_task() 从 Processor.current 移除
    — switched_task_cx_ptr 指向当前任务 TCBInner 中的 TaskContext 字段
    — 当前执行在内核态

    <b>Postconditions (不返回给调用者):</b>
    — 当前任务的 callee-saved 寄存器 (ra, sp, s0-s11) 已保存到 switched_task_cx_ptr
    — 控制流已通过 __switch 切换到 idle_task_cx
    — idle 控制流从 run_tasks() 循环中恢复执行
    — run_tasks() 将调用 fetch_task() 获取下一个 Ready 任务
    — 若就绪队列非空: 通过 __switch 切换到下一个任务的上下文
    — 若就绪队列为空: run_tasks() 循环等待
]
@enduml
