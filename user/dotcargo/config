[target.riscv64gc-unknown-none-elf]
rustflags = [
    "-Clink-args=-Tsrc/arch/linker_riscv64.ld", "-Cforce-frame-pointers=yes"
]

[target.loongarch64-unknown-none]
rustflags = [
    "-Clink-arg=-Tsrc/arch/linker_loongarch64.ld", "-Cforce-frame-pointers=yes",
    "-Clink-arg=-nostdlib",
    "-Clink-arg=-static",
    "-Clink-arg=--no-relax",
    "-Cpanic=abort"
]
linker = "rust-lld"

[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"